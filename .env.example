# ==========================================================
# MedCite — Medical Chatbot (RAG) : Environment Variables
# ----------------------------------------------------------
# Copy this file to `.env` in the project root and fill in
# your own keys. Never commit the real `.env` file.
#   cp .env.example .env        (macOS / Linux)
#   copy .env.example .env      (Windows)
#
# On Vercel, set the same REQUIRED variables under
# Project Settings > Environment Variables.
# ==========================================================

# ---------- Pinecone (REQUIRED) ----------
# Vector database holding the 384-dim embeddings.
# Get a key: https://app.pinecone.io  ->  API Keys
# Used by: store_index.py (index creation + upsert), app.py (retrieval)
PINECONE_API_KEY="your_pinecone_api_key_here"

# ---------- Groq (REQUIRED) ----------
# Powers answer generation.
# Get a key: https://console.groq.com/keys
# Used by: app.py -> ChatGroq
GROQ_API_KEY="your_groq_api_key_here"

# ---------- HuggingFace (REQUIRED at runtime) ----------
# Embeds the incoming question over HTTP, so the deployed app does not need
# torch. Same model and dimensions as the local ingestion path.
# Create a free READ token: https://huggingface.co/settings/tokens
# Used by: src/embeddings_api.py
HUGGINGFACEHUB_API_TOKEN="hf_your_read_token_here"


# ==========================================================
# Optional overrides — all have working defaults in code.
# Set these to change behavior without editing source.
# ==========================================================

# Groq model ID. Model IDs get retired; if you see a 404 from Groq,
# list the models your key can reach and set a live one here.
# GROQ_MODEL="llama-3.3-70b-versatile"

# Sampling temperature for the LLM
# LLM_TEMPERATURE="0.4"

# Pinecone index name (app.py reads this; store_index.py is hard-coded)
# PINECONE_INDEX_NAME="medical-chatbot"

# Number of chunks retrieved per question
# RETRIEVER_TOP_K="3"

# Override the HuggingFace feature-extraction endpoint if it moves
# HF_EMBED_URL="https://router.huggingface.co/hf-inference/models/sentence-transformers/all-MiniLM-L6-v2/pipeline/feature-extraction"

# Embedding model — must match the Pinecone index dimension (384)
# EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"

# Local Flask server only — ignored on Vercel
# FLASK_DEBUG="1"
# PORT="8080"


# ==========================================================
# Ingestion-time settings, still hard-coded in source.
# Listed for reference / future refactor into src/config.py
# ==========================================================
# Chunking          src/helper.py   chunk_size=500, chunk_overlap=20
# Index spec        store_index.py  dimension=384, cosine, aws/us-east-1
